# Database Configuration
POSTGRES_USER=focuz_user
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=focuz_db
DB_SSLMODE=require

# JWT Configuration
# Random, at least 32 characters (e.g. `openssl rand -hex 32`); empty = generated and kept in the database
JWT_SECRET=

# MinIO Configuration
MINIO_ROOT_USER=focuz_minio_user
MINIO_ROOT_PASSWORD=your_secure_minio_password_here
MINIO_EXTERNAL_ENDPOINT=https://your-minio-domain.com
# Optional: controls scheme for external presigned URLs (when using MINIO_EXTERNAL_ENDPOINT).
# If unset, inferred from MINIO_EXTERNAL_ENDPOINT (http/https) or falls back to MINIO_USE_SSL.
MINIO_EXTERNAL_USE_SSL=true

# Gin/Proxy Configuration
# Your reverse proxy's address only (empty = loopback only)
TRUSTED_PROXIES=
GIN_MODE=release

# Optional: App Environment
APP_ENV=production

# Optional: Uploads config
# Set a custom path if you do not use the default config/uploads.yaml inside the image
# UPLOADS_CONFIG_FILE=/path/to/uploads.yaml 